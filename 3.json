  "nodes": [
    {
      "parameters": {
        "jsCode": "const dataIn = $input.first().json.data;\nconst dataJson = JSON.parse(dataIn);\nconst totalBids = dataJson.response.response.numFound;\nconst totalPages = Math.ceil(totalBids / 10);\nconst thisPage = $('data holder').first().json.thisPage+1;\nconst bidIDs = $('data holder').first().json.bidIDs;\nconst docs = dataJson.response.response.docs;\nfor (const doc of docs) {\n  bidIDs.push(doc.id);\n}\nconst credentials = {\n  \"type\":$('Start').first().json.type_firstItem,\n  \"csrf\":$('Start').first().json.csrf_firstItem,\n  \"expires\":$('Start').first().json.expires_firstItem,\n  \"setCookies\":$('Start').first().json.setCookies_firstItem,\n};\nreturn [\n  {\n    json: {\n      totalPages,\n      thisPage,\n      bidIDs,\n      credentials ,\n      category:$('Start').first().json.categories_firstItem\n    },\n  },\n];\n"
      },
